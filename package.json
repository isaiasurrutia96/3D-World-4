    "build:hand-lab": "node hand-lab/build.mjs",
    "test:hand-lab": "node hand-lab/tests/browser.mjs",
    "build:foot-lab": "node foot-lab/build.mjs",
    "test:foot-lab": "node foot-lab/tests/browser.mjs",
    "build:avatar-lab": "node avatar-lab/build.mjs",
    "test:avatar-lab": "node avatar-lab/tests/browser.mjs",
    "build:avatar-test": "node avatar-test/build.mjs",
    "build:motion-lab": "node motion-lab/build.mjs",
    "test:motion-core": "node motion-core/tests/compare.mjs",
    "test:island": "node tests/island/check.mjs",
    "build:checkpoints": "node scripts/build-checkpoints.mjs",
    "test:movement": "node movement/tests/run.mjs",
    "build:run-test": "node run-test/build.mjs",
    "build:walk-test": "node walk-test/build.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "esbuild": "0.25.12",
    "playwright": "1.65.1",
    "typescript": "5.9.2",
    "vite": "7.1.5"
  }
