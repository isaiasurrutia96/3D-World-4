{
  "name": "3d-world-4",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:hand-lab && npm run build:foot-lab && npm run build:wrist-lab && npm run build:elbow-lab && npm run build:avatar-lab && npm run build:avatar-test && npm run build:motion-lab && npm run build:checkpoints && npm run build:run-test && npm run build:walk-test && npm run build:motion-core-test && npm run build:racing-lab && npm run build:skeleton-test && npm run build:new-avatar",
    "preview": "vite preview",
    "build:hand-lab": "node hand-lab/build.mjs",
    "test:hand-lab": "node hand-lab/tests/browser.mjs",
    "build:wrist-lab": "node wrist-lab/build.mjs",
    "test:wrist-lab": "node wrist-lab/tests/browser.mjs",
    "build:foot-lab": "node foot-lab/build.mjs",
    "test:foot-lab": "node foot-lab/tests/browser.mjs",
    "test:ankle": "node --test foot-lab/tests/ankle.test.mjs",
    "build:avatar-lab": "node avatar-lab/build.mjs",
    "test:avatar-lab": "node avatar-lab/tests/browser.mjs",
    "build:avatar-test": "node avatar-test/build.mjs",
    "build:motion-lab": "node motion-lab/build.mjs",
    "test:motion-core": "node motion-core/tests/compare.mjs",
    "test:skeleton": "node motion-core/tests/skeleton.mjs",
    "test:pose": "node motion-core/tests/pose.mjs",
    "test:balance": "node motion-core/tests/balance.mjs",
    "test:reach": "node motion-core/tests/reach.mjs",
    "test:grip": "node motion-core/tests/hands.mjs",
    "test:island": "node tests/island/check.mjs && node tests/island/solid.mjs",
    "test:world": "node tests/world/rulebook.mjs",
    "build:checkpoints": "node scripts/build-checkpoints.mjs",
    "test:movement": "node movement/tests/run.mjs",
    "build:run-test": "node run-test/build.mjs",
    "build:skeleton-test": "node skeleton-test/build.mjs",
    "build:new-avatar": "node new-avatar/build.mjs",
    "test:new-avatar": "node avatar-v2/check-torso.mjs && node avatar-v2/check-ball.mjs && node avatar-v2/check-limbs.mjs",
    "test:torso": "node tests/avatar/torso-split.mjs",
    "test:chest": "node tests/avatar/chest-bend.mjs",
    "test:hands": "node tests/avatar/hand-skin.mjs",
    "test:hand-tilt": "node tests/avatar/hand-tilt.mjs",
    "test:attach": "node skeleton-test/check.mjs",
    "build:motion-core-test": "node motion-core-test/build.mjs",
    "build:walk-test": "node walk-test/build.mjs",
    "test:motion-lab": "node motion-lab/test.mjs",
    "test:racing-core": "node --test racing-core/tests/core.test.mjs",
    "test:racing-kart": "node --test racing-core/kart/check.test.mjs",
    "test:racing-contacts": "node --test racing-core/contacts/check.test.mjs",
    "test:racing-drive": "node --test racing-core/testing/check.test.mjs",
    "test:racing-drive-browser": "node racing-lab/tests/driving-browser.mjs",
    "test:racing-camera": "node --test racing-lab/tests/chase-camera.test.mjs && node racing-lab/tests/chase-camera-browser.mjs",
    "test:racing-app": "node --test racing-lab/tests/app.test.mjs && node racing-lab/tests/app-browser.mjs",
    "test:racing-home-screen": "node --test racing-lab/tests/page-activity.test.mjs && node racing-lab/tests/home-screen-browser.mjs",
    "build:racing-lab": "node racing-lab/build.mjs",
    "test:racing-lab": "node racing-lab/tests/browser.mjs",
    "test:inspection-zoom": "node --test test-lab/zoom.test.mjs",
    "build:elbow-lab": "node elbow-lab/build.mjs",
    "test:elbow-lab": "node elbow-lab/tests/browser.mjs",
    "test:study-assets": "node --test tests/study-asset.test.mjs",
    "test:study-startup": "node tests/study-startup.mjs",
    "build:joint-assembly": "node scripts/build-joint-assembly.mjs",
    "test:joint-assembly": "node --test tests/avatar/joint-assembly.mjs",
    "preview:joint-assembly": "node scripts/preview-joint-avatar.mjs",
    "test:official-avatar": "node --test tests/avatar/official-avatar.mjs tests/avatar/delivery.mjs",
    "build:avatar-delivery": "node scripts/build-avatar-delivery.mjs",
    "test:avatar-startup": "node tests/avatar/startup.mjs",
    "test:official-avatar-browser": "node tests/avatar/official-browser.mjs"
  },
  "dependencies": {
    "cdt2d": "1.0.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "esbuild": "0.25.12",
    "meshoptimizer": "0.22.0",
    "playwright": "1.65.1",
    "typescript": "5.9.2",
    "vite": "7.1.5"
  }
}
